# LLM_API_STYLE=ollama uses Ollama native /api/chat (thinking off).
# Set LLM_API_STYLE=openai and point LLM_BASE_URL at e.g. https://api.groq.com/openai/v1 for a hosted provider.
LLM_API_STYLE=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.7
LLM_SEED=42
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=300
SESSION_SECRET=change-me-to-a-long-random-string
DATA_FILE=data/attempts.jsonl

# Supabase: the SECRET (service_role) key — RLS is on with no policies, so a
# publishable/anon key cannot read or write. Leave blank to log to DATA_FILE instead.
SUPABASE_URL= 
SUPABASE_SERVICE_KEY=
